# 复制到 apps/server/.env；相对路径以 apps/server 为基准。
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=data/mlclaw.sqlite
# QQ 与微信渠道在网页“消息渠道”中配置；凭据保存在上述数据库，不新增渠道环境变量。
# Tavily 在网页“联网搜索”中配置；密钥保存在上述数据库，不需要联网搜索环境变量。
WORKSPACE_PATH=workspace
# 可选：独立执行服务，留空时不注册命令工具。两端使用相同的随机令牌。
EXECUTOR_URL=
EXECUTOR_TOKEN=
ADMIN_USERNAME=admin
# 首次启动前填写自己生成的 12–256 字符密码；初始化后可移除此变量。
ADMIN_PASSWORD=
# 开发默认通过 Vite 访问；构建后可设为 true，由后端托管前端。
SERVE_WEB=false
# 生产模式要求 HTTPS 来源并启用 Secure Cookie；容器配置见 deploy/.env.example。
NODE_ENV=development
# 技术诊断日志输出到标准输出；可选 info、warn 或 error。
LOG_LEVEL=info
